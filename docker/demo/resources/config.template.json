{
  "environment": "__APP_ENV__",
  "i18n": {
    "languages": ["fr-FR", "en-US"],
    "locale": "fr-FR",
    "i18nFiles": [
      "common.json",
      "accounts.json",
      "applications.json",
      "organizational-units.json",
      "roles.json",
      "groups.json"
    ]
  },
  "immediateActionDelay": 60,
  "themeVariables": {
    "primary": "#1976d2",
    "secondary": "#26a69a",
    "accent": "#9c27b0",
    "dark": "#1d1d1d",
    "positive": "#21ba45",
    "negative": "#c10015",
    "info": "#31ccec",
    "warning": "#f2c037"
  },
  "remotes": [
    {
      "name": "LinPulsar",
      "entry": "/lin-pulsar/mf-manifest.json"
    }
  ],
  "modules": [],
  "extraZones": [],
  "designFiles": [
    "design/default.json",
    "design/base-layout.json",
    "design/account-details.json",
    "design/organizational-unit-details.json",
    "design/organizational-unit-banner.json",
    "design/organizational-unit-info-text.json",
    "design/status-badge.json",
    "design/account-banner.json",
    "design/account-info-text.json",
    "design/accounts-page.json",
    "design/applications-page.json",
    "design/application-creation.json",
    "design/account-creation.json",
    "design/organizational-units-page.json",
    "design/organizational-unit-creation.json",
    "design/application-details.json",
    "design/roles-page.json",
    "design/role-creation.json",
    "design/groups-page.json",
    "design/group-creation.json",
    "design/group-details.json"
  ],
  "organizationalUnitLifecycleFields": {
    "suspension.immediate": [
      {
        "name": "reason",
        "type": "String",
        "input": "List",
        "required": true,
        "inputSettings": {
          "values": [
            "Suspension Reason A",
            "Suspension Reason B",
            "Suspension Reason C"
          ]
        }
      },
      {
        "name": "subreason",
        "type": "String",
        "input": "List",
        "required": true,
        "inputSettings": {
          "values": [
            {
              "value": "Suspension Sub-reason A.1",
              "filterContext": { "reason": "Suspension Reason A" }
            },
            {
              "value": "Suspension Sub-reason A.2",
              "filterContext": { "reason": "Suspension Reason A" }
            },
            {
              "value": "Suspension Sub-reason B.1",
              "filterContext": { "reason": "Suspension Reason B" }
            },
            {
              "value": "Suspension Sub-reason C.1",
              "filterContext": { "reason": "Suspension Reason C" }
            }
          ]
        }
      },
      {
        "name": "comment",
        "type": "String",
        "input": "TextArea",
        "required": false
      }
    ],
    "suspension.scheduled": [
      {
        "name": "start",
        "type": "String",
        "input": "Date",
        "required": true,
        "inputSettings": {
          "maskI18NKey": "application.dateFormat",
          "valueFormatI18NKey": "application.dateFormatApi",
          "options": { "afterDate": "{{ today }}" }
        }
      },
      {
        "name": "end",
        "type": "String",
        "input": "Date",
        "required": false,
        "inputSettings": {
          "maskI18NKey": "application.dateFormat",
          "valueFormatI18NKey": "application.dateFormatApi",
          "options": {
            "afterDate": "{{ today }}",
            "fromDate": "{{ entity.start }}"
          }
        }
      },
      {
        "name": "reason",
        "type": "String",
        "input": "List",
        "required": true,
        "inputSettings": {
          "values": [
            "Suspension Reason A",
            "Suspension Reason B",
            "Suspension Reason C"
          ]
        }
      },
      {
        "name": "subreason",
        "type": "String",
        "input": "List",
        "required": true,
        "inputSettings": {
          "values": [
            {
              "value": "Suspension Sub-reason A.1",
              "filterContext": { "reason": "Suspension Reason A" }
            },
            {
              "value": "Suspension Sub-reason A.2",
              "filterContext": { "reason": "Suspension Reason A" }
            },
            {
              "value": "Suspension Sub-reason B.1",
              "filterContext": { "reason": "Suspension Reason B" }
            },
            {
              "value": "Suspension Sub-reason C.1",
              "filterContext": { "reason": "Suspension Reason C" }
            }
          ]
        }
      },
      {
        "name": "comment",
        "type": "String",
        "input": "TextArea",
        "required": false
      }
    ],
    "suspension.modify-end": [
      {
        "name": "end",
        "type": "String",
        "input": "Date",
        "required": false,
        "inputSettings": {
          "maskI18NKey": "application.dateFormat",
          "valueFormatI18NKey": "application.dateFormatApi",
          "options": {
            "afterDate": "{{ today }}",
            "fromDate": "{{ entity.start }}"
          }
        }
      },
      {
        "name": "reason",
        "type": "String",
        "input": "List",
        "required": true,
        "inputSettings": {
          "values": [
            "Suspension Reason A",
            "Suspension Reason B",
            "Suspension Reason C"
          ]
        }
      },
      {
        "name": "subreason",
        "type": "String",
        "input": "List",
        "required": true,
        "inputSettings": {
          "values": [
            {
              "value": "Suspension Sub-reason A.1",
              "filterContext": { "reason": "Suspension Reason A" }
            },
            {
              "value": "Suspension Sub-reason A.2",
              "filterContext": { "reason": "Suspension Reason A" }
            },
            {
              "value": "Suspension Sub-reason B.1",
              "filterContext": { "reason": "Suspension Reason B" }
            },
            {
              "value": "Suspension Sub-reason C.1",
              "filterContext": { "reason": "Suspension Reason C" }
            }
          ]
        }
      },
      {
        "name": "comment",
        "type": "String",
        "input": "TextArea",
        "required": false
      }
    ],
    "reactivation.immediate": [
      {
        "name": "comment",
        "type": "String",
        "input": "TextArea",
        "required": true
      }
    ]
  }
}
