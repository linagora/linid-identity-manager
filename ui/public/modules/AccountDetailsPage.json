      "plugin": "LinPulsar/GenericEditableTableCard",
      "props": {
        "rowKey": "id",
        "enableActions": false,
        "enableRowActions": false,
        "i18nScope": "moduleAccountDetailsPage.groups",
        "uiNamespace": "moduleAccountDetailsPage.groups",
        "columns": [
          {
            "name": "code",
