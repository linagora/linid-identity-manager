@startuml C3-UI-Components
' ============================================================================
' LinID Identity Manager — C4 Level 3: Components of the LinID UI (SPA) container
' ============================================================================
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Component.puml

LAYOUT_WITH_LEGEND()
title LinID UI (SPA, Module Federation host) — Components (C3)

Container_Boundary(spa, "LinID UI (SPA)") {

  ' --- Boot files (in Quasar boot order) -------------------------------------
  Component(boot_dayjs, "dayjs boot", "Boot file", "Extends Day.js with utc & customParseFormat; registers it in lin-pulsar-core.")
  Component(boot_pinia, "pinia boot", "Boot file", "Creates Pinia, registers it in lin-pulsar-core; pre-registers the LinPulsar dialog plugins in the zone store.")
  Component(boot_nunjucks, "nunjucks boot", "Boot file", "Configures the Nunjucks templating environment; registers it in lin-pulsar-core.")
  Component(boot_config, "config boot", "Boot file", "Fetches the runtime configuration /config.json (i18n, remotes, modules, theme, design files, lifecycle fields).")
  Component(boot_axios, "axios boot", "Boot file", "Creates the Axios instance (baseURL /backend); redirects to /auth/login on 401; registers it in lin-pulsar-core.")
  Component(boot_auth, "auth boot", "Boot file", "Reads the user claims from /auth/me; redirects to /auth/login without session; populates the user store & preferences.")
  Component(boot_i18n, "i18n boot", "Boot file", "Loads API translations (/backend/i18n/{lang}.json) and static files (/i18n/{lang}/*.json); merges them; creates Vue I18n.")
  Component(boot_lifecycle, "module-lifecycle boot", "Boot file", "Calls linPulsarModuleFederation.init: registers remotes, module configs, extra zones and host-local components; runs the lifecycle phases.")
  Component(boot_theme, "theme boot", "Boot file", "Applies the theme variables of config.json as --q-{key} CSS custom properties.")
  Component(boot_ui_design, "ui-design boot", "Boot file", "Fetches and merges the design JSON files; registers the UI design in lin-pulsar-core.")

  ' --- Services ------------------------------------------------------------
  Component(auth_service, "AuthService", "Service", "getUserClaims (/auth/me), getLoginUrl (/auth/login?returnTo=…).")
  Component(account_service, "AccountService", "Service", "REST client for the account lifecycle (PUT /accounts/{id}/status/*).")
  Component(application_service, "ApplicationService", "Service", "REST client: exportApplicationScript (GET /applications/{id}/script).")
  Component(ou_service, "OrganizationalUnitService", "Service", "REST client for the OU lifecycle (GET/PUT /organizational-units/{id}/*).")

  ' --- Stores (from @linagora/lin-pulsar-core) -----------------------------
  Component(user_store, "useLinPulsarUserStore", "Pinia Store (lin-pulsar-core)", "Claims of the logged-in user.")
  Component(user_pref_store, "useLinPulsarUserPreference", "Pinia Store (lin-pulsar-core)", "User preferences (e.g. language).")
  Component(ui_store, "useLinPulsarUiStore", "Pinia Store (lin-pulsar-core)", "Languages, current locale, navigation menu items.")
  Component(zone_store, "useLinPulsarZoneStore", "Pinia Store (lin-pulsar-core)", "Zone-based plugin registry: maps zone keys to federated components.")

  ' --- Composables ---------------------------------------------------------
  Component(use_account_mapper, "useAccountMapper", "Composable", "Maps AccountDTO to AccountStatus and form values to API records.")
  Component(use_account_lifecycle_ui, "useAccountLifecycleUi", "Composable", "Projects the account status into lifecycle UI state (badges, banners, info text, actions).")
  Component(use_ou_mapper, "useOrganizationalUnitMapper", "Composable", "Maps OrganizationalUnitDTO to OrganizationalUnitStatus and form values to API records.")
  Component(use_ou_lifecycle_ui, "useOrganizationalUnitLifecycleUi", "Composable", "Projects the OU status into lifecycle UI state.")
  Component(use_lifecycle_dialogs, "useLifecycleDialogs", "Composable", "Opens the LinPulsar FormDialog & ConfirmationDialog through UI events.")

  ' --- Local components ----------------------------------------------------
  Component(homepage, "Homepage", "Page", "Intro / open-source / license / branding HTML from i18n.")
  Component(auth_logout, "AuthenticationLogoutPage", "Page", "Redirects to /auth/logout (logout handled by the UI server).")
  Component(account_lifecycle_panel, "AccountLifecyclePanel", "Panel", "Account lifecycle: banners, info texts, dialogs; emits account-status-updated.")
  Component(ou_lifecycle_panel, "OrganizationalUnitLifecyclePanel", "Panel", "OU lifecycle: banner, info text, dialogs; emits organizational-unit-status-updated.")
  Component(export_script_btn, "ExportApplicationScriptBtn", "Button", "Downloads the OPA Rego script of an application.")
  Component(ou_create_child_btn, "OrganizationalUnitCreateChildBtn", "Button", "Opens /organizational-units/new?parent={id}.")
  Component(ou_parent_field, "OrganizationalUnitParentField", "Field", "Resolves the parent OU from the route query.")
  Component(banners_texts, "Banners & info texts", "Banner / Info Text", "Account and OU suspended, deactivated, not-activated banners and info texts.")

  ' --- Module config files (dynamic routes) -------------------------------
  Component(module_configs, "Module config files", "JSON Config", "/modules/*.json: one file per page (list, creation, details) of accounts, OUs, groups, roles and applications. Drive the dynamic routes and the LinPulsar pages.")
}

' --- LinOpenFactory: Module Federation remote -------------------------------
Container_Boundary(lof, "LinOpenFactory") {
  Component(lin_pulsar, "LinPulsar", "Vue 3, Quasar, Module Federation remote", "BaseLayout, GenericTablePage, GenericDetailsPage, GenericCreationPage, EntityProfilePanel, GenericEditableTableCard, SupersetWidgetCard, FormDialog, ConfirmationDialog, NavigationMenu, HeaderProfile, StatusBadge, smart filter…")
}

' --- Other containers --------------------------------------------------------
Container_Ext(bff, "UI server (BFF)", "Fastify", "OIDC, session, proxies /backend, /auth, /lin-pulsar")
Container_Ext(superset, "Apache Superset", "Superset 6.1.0", "BI dashboard engine (optional)")

' --- Relationships: boot ------------------------------------------------------
Rel(boot_pinia, zone_store, "Pre-registers dialog plugins")
Rel(boot_config, bff, "GET /config.json", "HTTPS")
Rel(boot_config, boot_lifecycle, "Provides remotes & module config")
Rel(boot_theme, boot_config, "Reads theme variables")
Rel(boot_ui_design, boot_config, "Reads design file list")
Rel(boot_auth, auth_service, "Uses")
Rel(boot_auth, user_store, "Populates")
Rel(boot_auth, user_pref_store, "Populates")
Rel(boot_i18n, ui_store, "Sets languages & locale")
Rel(boot_i18n, bff, "Fetches translations", "HTTPS")
Rel(boot_lifecycle, module_configs, "Loads module configs for dynamic routes")
Rel(boot_lifecycle, lin_pulsar, "Loads the remote through /lin-pulsar/mf-manifest.json", "Module Federation")

' --- Relationships: services ----------------------------------------------------
Rel(auth_service, bff, "GET /auth/me", "HTTPS")
Rel(account_service, bff, "/backend/accounts/{id}/status/*", "HTTPS/REST")
Rel(application_service, bff, "/backend/applications/{id}/script", "HTTPS/REST")
Rel(ou_service, bff, "/backend/organizational-units/{id}/*", "HTTPS/REST")

' --- Relationships: panels & composables -----------------------------------------
Rel(account_lifecycle_panel, use_account_lifecycle_ui, "Uses")
Rel(account_lifecycle_panel, use_lifecycle_dialogs, "Uses")
Rel(account_lifecycle_panel, account_service, "Calls lifecycle endpoints")
Rel(account_lifecycle_panel, banners_texts, "Shows")
Rel(ou_lifecycle_panel, use_ou_lifecycle_ui, "Uses")
Rel(ou_lifecycle_panel, use_lifecycle_dialogs, "Uses")
Rel(ou_lifecycle_panel, ou_service, "Calls lifecycle endpoints")
Rel(ou_lifecycle_panel, banners_texts, "Shows")
Rel(use_account_mapper, account_service, "Maps DTOs to API records")
Rel(use_ou_mapper, ou_service, "Maps DTOs to API records")
Rel(use_lifecycle_dialogs, lin_pulsar, "Opens FormDialog / ConfirmationDialog")

' --- Relationships: local components registered in zones ---------------------------
Rel(boot_lifecycle, account_lifecycle_panel, "Registers in account details zone")
Rel(boot_lifecycle, ou_lifecycle_panel, "Registers in OU details zone")
Rel(boot_lifecycle, export_script_btn, "Registers in application details zone")
Rel(boot_lifecycle, ou_create_child_btn, "Registers in OU details zone")
Rel(boot_lifecycle, ou_parent_field, "Registers in OU creation form zone")

' --- Relationships: LinPulsar ------------------------------------------------------
Rel(lin_pulsar, bff, "Generic pages call /backend/{entity}", "HTTPS/REST")
Rel(lin_pulsar, superset, "SupersetWidgetCard embeds dashboards (guest token)", "HTTPS")

@enduml
