{
  "instanceId": "moduleOrganizationalUnitDetailsPage",
  "remoteName": "LinPulsar",
  "entity": "organizational-units",
  "lifecycleRemote": "LinPulsar/PageLifecycle",
  "routesRemote": "LinPulsar/PageRoutes",
  "i18nRemote": "LinPulsar/EmptyI18n",
  "apiEndpoint": "organizational-units",
  "basePath": "/organizational-units",
  "zones": [
    {
      "zone": "moduleOrganizationalUnitDetailsPage.entity-profile-panel.actions.prepend",
      "component": "OrganizationalUnitCreateChildBtn"
    },
    {
      "zone": "moduleOrganizationalUnitDetailsPage.side-left",
      "plugin": "LinPulsar/EntityProfilePanel",
      "props": {
        "statusKey": "status",
        "parentPath": "/organizational-units",
        "avatarOptions": {
          "seed": ["{{ entity.name }}"],
          "style": "constellation",
          "styleOptions": {
            "animationVariant": "fast"
          }
        },
        "avatarLocation": "/avatars/organizational-units/{{ entity.id }}.png",
        "importOptions": {
          "enabled": true,
          "maxFileSize": 10,
          "allowedExtensions": ["png"],
          "endpoints": {
            "upload": "/avatars/organizational-units/{{ entity.id }}",
            "delete": "/avatars/organizational-units/{{ entity.id }}"
          }
        },
        "fieldOrder": ["type"],
        "updateEndpoint": "/organizational-units/{{ entity.id }}",
        "updateBody": {
          "parent": "{{ entity.parents[0].parent }}",
          "name": "{{ entity.name }}",
          "type": "{{ entity.type }}",
          "extraParameters": {}
        },
        "formFields": [
          {
            "name": "name",
            "type": "String",
            "input": "Text",
            "required": true,
            "inputSettings": {}
          },
          {
            "name": "type",
            "type": "String",
            "input": "List",
            "required": true,
            "inputSettings": {
              "values": ["COMPANY", "DIVISION", "DEPARTMENT", "TEAM"]
            }
          }
        ],
        "emitOnUpdate": "organizational-unit-updated"
      }
    },
    {
      "zone": "moduleOrganizationalUnitDetailsPage.content.before",
      "component": "OrganizationalUnitLifecyclePanel",
      "props": {
        "banners": [
          {
            "key": "suspended",
            "actions": ["reactivation.immediate", "suspension.modify-end"],
            "content": "{{ 'contentWithEndDate' if entity.suspensionPeriod.end else 'content' }}",
            "params": {
              "date": {
                "field": "suspensionPeriod.start",
                "formatter": "toDate",
                "formatOptions": {
                  "formatKey": "application.dateFormat"
                }
              },
              "endDate": {
                "field": "suspensionPeriod.end",
                "formatter": "toDate",
                "formatOptions": {
                  "formatKey": "application.dateFormat"
                }
              }
            }
          }
        ],
        "immediateActionDelay": 60,
        "actions": {
          "suspension.immediate": {
            "dialog": "form",
            "url": "/organizational-units/{{ entity.id }}/status/suspend",
            "method": "PUT",
            "formFields": [
              {
                "name": "reason",
                "type": "String",
                "input": "List",
                "required": true,
                "inputSettings": {
                  "values": [
                    "Suspension Reason A",
                    "Suspension Reason B",
                    "Suspension Reason C"
                  ]
                }
              },
              {
                "name": "subreason",
                "type": "String",
                "input": "List",
                "required": true,
                "inputSettings": {
                  "values": [
                    {
                      "value": "Suspension Sub-reason A.1",
                      "filterContext": {
                        "reason": "Suspension Reason A"
                      }
                    },
                    {
                      "value": "Suspension Sub-reason A.2",
                      "filterContext": {
                        "reason": "Suspension Reason A"
                      }
                    },
                    {
                      "value": "Suspension Sub-reason B.1",
                      "filterContext": {
                        "reason": "Suspension Reason B"
                      }
                    },
                    {
                      "value": "Suspension Sub-reason C.1",
                      "filterContext": {
                        "reason": "Suspension Reason C"
                      }
                    }
                  ]
                }
              },
              {
                "name": "comment",
                "type": "String",
                "input": "TextArea",
                "required": false
              }
            ],
            "body": {
              "suspensionPeriod": {
                "start": "{{ immediateDate }}"
              },
              "reason": "{{ entity.reason }}",
              "subreason": "{{ entity.subreason }}",
              "comment": "{{ entity.comment }}"
            }
          },
          "suspension.scheduled": {
            "dialog": "form",
            "url": "/organizational-units/{{ entity.id }}/status/suspend",
            "method": "PUT",
            "formFields": [
              {
                "name": "suspensionPeriod.start",
                "type": "String",
                "input": "Date",
                "required": true,
                "inputSettings": {
                  "maskI18NKey": "application.dateFormat",
                  "valueFormatI18NKey": "application.dateFormatApi",
                  "options": {
                    "afterDate": "{{ today }}"
                  }
                }
              },
              {
                "name": "suspensionPeriod.end",
                "type": "String",
                "input": "Date",
                "required": false,
                "inputSettings": {
                  "maskI18NKey": "application.dateFormat",
                  "valueFormatI18NKey": "application.dateFormatApi",
                  "options": {
                    "afterDate": "{{ today }}",
                    "fromDate": "{{ entity.suspensionPeriod.start }}"
                  }
                }
              },
              {
                "name": "reason",
                "type": "String",
                "input": "List",
                "required": true,
                "inputSettings": {
                  "values": [
                    "Suspension Reason A",
                    "Suspension Reason B",
                    "Suspension Reason C"
                  ]
                }
              },
              {
                "name": "subreason",
                "type": "String",
                "input": "List",
                "required": true,
                "inputSettings": {
                  "values": [
                    {
                      "value": "Suspension Sub-reason A.1",
                      "filterContext": {
                        "reason": "Suspension Reason A"
                      }
                    },
                    {
                      "value": "Suspension Sub-reason A.2",
                      "filterContext": {
                        "reason": "Suspension Reason A"
                      }
                    },
                    {
                      "value": "Suspension Sub-reason B.1",
                      "filterContext": {
                        "reason": "Suspension Reason B"
                      }
                    },
                    {
                      "value": "Suspension Sub-reason C.1",
                      "filterContext": {
                        "reason": "Suspension Reason C"
                      }
                    }
                  ]
                }
              },
              {
                "name": "comment",
                "type": "String",
                "input": "TextArea",
                "required": false
              }
            ],
            "body": {
              "suspensionPeriod": "{{ entity.suspensionPeriod }}",
              "reason": "{{ entity.reason }}",
              "subreason": "{{ entity.subreason }}",
              "comment": "{{ entity.comment }}"
            }
          },
          "suspension.modify-end": {
            "dialog": "form",
            "url": "/organizational-units/{{ entity.id }}/status/suspend",
            "method": "PUT",
            "fillFormWithEntity": true,
            "formFields": [
              {
                "name": "suspensionPeriod.end",
                "type": "String",
                "input": "Date",
                "required": false,
                "inputSettings": {
                  "maskI18NKey": "application.dateFormat",
                  "valueFormatI18NKey": "application.dateFormatApi",
                  "options": {
                    "afterDate": "{{ today }}",
                    "fromDate": "{{ entity.suspensionPeriod.start }}"
                  }
                }
              },
              {
                "name": "reason",
                "type": "String",
                "input": "List",
                "required": true,
                "inputSettings": {
                  "values": [
                    "Suspension Reason A",
                    "Suspension Reason B",
                    "Suspension Reason C"
                  ]
                }
              },
              {
                "name": "subreason",
                "type": "String",
                "input": "List",
                "required": true,
                "inputSettings": {
                  "values": [
                    {
                      "value": "Suspension Sub-reason A.1",
                      "filterContext": {
                        "reason": "Suspension Reason A"
                      }
                    },
                    {
                      "value": "Suspension Sub-reason A.2",
                      "filterContext": {
                        "reason": "Suspension Reason A"
                      }
                    },
                    {
                      "value": "Suspension Sub-reason B.1",
                      "filterContext": {
                        "reason": "Suspension Reason B"
                      }
                    },
                    {
                      "value": "Suspension Sub-reason C.1",
                      "filterContext": {
                        "reason": "Suspension Reason C"
                      }
                    }
                  ]
                }
              },
              {
                "name": "comment",
                "type": "String",
                "input": "TextArea",
                "required": false
              }
            ],
            "body": {
              "suspensionPeriod": "{{ entity.suspensionPeriod }}",
              "reason": "{{ entity.reason }}",
              "subreason": "{{ entity.subreason }}",
              "comment": "{{ entity.comment }}"
            }
          },
          "reactivation.immediate": {
            "dialog": "form",
            "url": "/organizational-units/{{ entity.id }}/status/reactivate",
            "method": "PUT",
            "formFields": [
              {
                "name": "comment",
                "type": "String",
                "input": "TextArea",
                "required": true
              }
            ],
            "body": {
              "comment": "{{ entity.comment }}"
            }
          }
        }
      }
    },
    {
      "zone": "moduleOrganizationalUnitDetailsPage.content.after",
      "plugin": "LinPulsar/GenericEditableTableCard",
      "props": {
        "rowKey": "id",
        "columns": [
          {
            "name": "lastname",
            "label": "columns.lastname",
            "field": "lastname",
            "align": "left"
          },
          {
            "name": "firstname",
            "label": "columns.firstname",
            "field": "firstname",
            "align": "left"
          },
          {
            "name": "email",
            "label": "columns.email",
            "field": "email",
            "align": "left"
          },
          {
            "name": "roleName",
            "label": "columns.roleName",
            "field": "roleName",
            "align": "left"
          }
        ],
        "formFields": [
          {
            "name": "accountId",
            "type": "String",
            "input": "DynamicList",
            "required": true,
            "inputSettings": {
              "route": "/accounts",
              "optionLabel": "{{ lastname }} {{ firstname }} ({{ email }})",
              "optionValue": "{{ id }}"
            }
          },
          {
            "name": "roleId",
            "type": "String",
            "input": "DynamicList",
            "required": true,
            "inputSettings": {
              "route": "/roles",
              "optionLabel": "{{ name }}",
              "optionValue": "{{ id }}"
            }
          }
        ],
        "editFormFields": [
          {
            "name": "roleId",
            "type": "String",
            "input": "DynamicList",
            "required": true,
            "inputSettings": {
              "route": "/roles",
              "optionLabel": "{{ name }}",
              "optionValue": "{{ id }}"
            }
          }
        ],
        "updateBody": {
          "roleId": "{{ formData.roleId }}"
        },
        "endpoints": {
          "find": "/organizational-units/{{ entity.id }}/accounts",
          "create": "/organizational-units/{{ entity.id }}/accounts",
          "delete": "/organizational-units/{{ entity.id }}/accounts/{{ item.id }}",
          "update": "/organizational-units/{{ entity.id }}/accounts/{{ item.id }}"
        }
      }
    }
  ],
  "options": {
    "layout": "LinPulsar/BaseLayout",
    "page": "LinPulsar/GenericDetailsPage",
    "pagePath": ":id",
    "parentPath": "/organizational-units",
    "enableActions": false,
    "reloadDetailsOn": [
      "organizational-unit-status-updated",
      "organizational-unit-updated"
    ],
    "sections": [
      {
        "key": "lifecycle",
        "fieldOrder": [
          "insertDate",
          "createdBy",
          "updateDate",
          "updatedBy",
          "suspensionPeriod.start",
          "suspensionPeriod.end"
        ],
        "formatters": [
          {
            "field": "insertDate",
            "formatter": "toDate",
            "formatOptions": {
              "formatKey": "application.dateFormat"
            }
          },
          {
            "field": "updateDate",
            "formatter": "toDate",
            "formatOptions": {
              "formatKey": "application.dateFormat"
            }
          },
          {
            "field": "suspensionPeriod.start",
            "formatter": "toDate",
            "formatOptions": {
              "formatKey": "application.dateFormat"
            }
          },
          {
            "field": "suspensionPeriod.end",
            "formatter": "toDate",
            "formatOptions": {
              "formatKey": "application.dateFormat"
            }
          }
        ]
      }
    ]
  }
}
