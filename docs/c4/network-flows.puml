@startuml network-flows
' ============================================================================
' LinID Identity Manager — Network Flows
' ============================================================================
' All network flows with: source, destination, port, protocol, authentication,
' encryption, internal/external scope.
' Ports are those of the e2e environment (docker/e2e/docker-compose.yml).
' Companion table: network-flows-table.puml.
' ============================================================================

skinparam backgroundColor #FEFEFE
skinparam defaultFontName "DejaVu Sans"
skinparam roundCorner 8
skinparam ArrowFontName "DejaVu Sans"
skinparam ArrowFontSize 9
skinparam NodeFontName "DejaVu Sans"
skinparam NodeFontSize 10
skinparam noteFontSize 8

title LinID Identity Manager — Network Flows (e2e environment)

' --- Style definitions -----------------------------------------------------
skinparam rectangle {
  BackgroundColor<<ui>>        #E3F2FD
  BackgroundColor<<api>>       #E8F5E9
  BackgroundColor<<auth>>      #FFF3E0
  BackgroundColor<<opa>>       #F3E5F5
  BackgroundColor<<superset>>  #FCE4EC
  BackgroundColor<<lof>>       #E0F7FA
  BackgroundColor<<future>>    #ECEFF1
  BorderColor                  #555555
}
skinparam database {
  BackgroundColor #E8EAF6
  BorderColor     #555555
}

' --- External network ------------------------------------------------------
cloud "External Network\n(browsers)" as ext #FFEBEE

' --- Docker network boundary ----------------------------------------------
node "Docker Network (linid-e2e-network)\nTrust assumption: plain-text flows rely on this network being private" as docker {

  rectangle "**UI server (BFF)**\nimage: linid-identity-manager-ui\nFastify (HTTPS)\n:9000 -> :443" as ui <<ui>>
  rectangle "**LinID API**\nimage: linid-identity-manager-api\nSpring Boot (HTTPS)\n:8443" as api <<api>>
  rectangle "**LinID Sync API**\nimage: linid-identity-manager-sync-api\nSpring Boot (HTTPS, mutual TLS)\n:8444 -> :8443" as sync_api <<api>>
  rectangle "**LinPulsar** (LinOpenFactory)\nimage: linagora/lin-pulsar:v0.3.6\nHTTP :80" as lin_pulsar <<lof>>
  rectangle "**LemonLDAP::NG**\nimage: lemonldapng/lemonldap-ng:2.23\nHTTP :80" as auth <<auth>>
  rectangle "**OPA**\nimage: openpolicyagent/opa:1.18.1\nHTTP :8181" as opa <<opa>>
  rectangle "**Apache Superset** (optional)\nFROM apache/superset:6.1.0\nGunicorn (HTTPS)\n:8088 -> :8443" as superset <<superset>>
  database "**PostgreSQL**\nimage: postgres:18.4-alpine\n:5432\nDBs: linid, sync_api, lemon,\nsuperset, datalake" as db

  database "**LDAP Directory**\n(future)" as ldap <<future>>
}

cloud "External Referential\n(future)\ne.g. HR system" as referentiel #ECEFF1

' ===========================================================================
' EXTERNAL FLOWS (red)
' ===========================================================================

ext -[#EF5350]-> ui : "**F1** Browser -> UI server (SPA, /backend, /lin-pulsar)\nHTTPS :9000->443\nSession cookie | TLS | External"

ext -[#EF5350]-> ui : "**F2** Browser -> LemonLDAP portal (via UI server /auth/)\nHTTPS :9000->443\nUsername/password | TLS | External"

ext -[#EF5350]-> superset : "**F3** Admin -> Superset (dashboard design)\nHTTPS :8088->8443\nUsername/password | TLS | External"

ext -[#EF5350]-> superset : "**F4** Browser -> Superset (embedded dashboards)\nHTTPS :8088->8443\nGuest token | TLS | External"

ext -[#EF5350]-> api : "**F5** Admin -> API (Swagger UI)\nHTTPS :8443\nJWT | TLS | External"

' ===========================================================================
' INTERNAL FLOWS — UI server (green)
' ===========================================================================

ui -[#66BB6A]-> api : "**F6** UI server -> API (proxy /backend/)\nHTTPS :8443 | JWT bearer | TLS | Internal"

ui -[#66BB6A]-> auth : "**F7** UI server -> LemonLDAP (proxy /auth/: portal, token endpoint, userinfo, JWKS)\nHTTP :80 | Portal session / Client id/secret / JWT bearer | None | Internal"

ui -[#66BB6A]-> auth : "**F8** UI server -> LemonLDAP (OIDC discovery, at startup)\nHTTP :80 | None | None | Internal"

ui -[#66BB6A]-> ui : "**F8b** UI server -> UI server (token endpoint /auth/oauth2/token: code exchange, refresh, then F7)\nHTTPS :443 | Client id/secret | TLS | Internal"

ui -[#66BB6A]-> lin_pulsar : "**F9** UI server -> LinPulsar (proxy /lin-pulsar/)\nHTTP :80 | None | None | Internal"

' ===========================================================================
' INTERNAL FLOWS — API (green)
' ===========================================================================

api -[#66BB6A]-> db : "**F10** API -> PostgreSQL (linid DB)\nJDBC :5432 | DB user/pass | None | Internal"

api -[#66BB6A]-> opa : "**F11** API -> OPA (publish policies)\nREST :8181 | None | None | Internal"

api -[#66BB6A]-> ui : "**F12** API -> UI server (JWKS /auth/oauth2/jwks, then F7)\nHTTPS :443 | None (public) | TLS | Internal"

api -[#66BB6A]-> superset : "**F13** API -> Superset (guest tokens)\nREST :8443 | Service account | TLS | Internal"

api -[#66BB6A]-> sync_api : "**F14** API -> Sync API\nREST :8443 | Client certificate | Mutual TLS | Internal"

' ===========================================================================
' INTERNAL FLOWS — Sync API, LemonLDAP, Superset (green)
' ===========================================================================

sync_api -[#66BB6A]-> db : "**F15** Sync API -> PostgreSQL (linid & sync_api DBs)\nJDBC :5432 | DB user/pass | None | Internal"

sync_api -[#66BB6A]-> opa : "**F16** Sync API -> OPA (evaluate decisions)\nREST :8181 | None | None | Internal"

auth -[#66BB6A]-> db : "**F17** LemonLDAP -> PostgreSQL (lemon DB)\nDBI :5432 | DB user/pass | None | Internal"

superset -[#66BB6A]-> db : "**F18** Superset -> PostgreSQL (superset & datalake DBs)\nSQLAlchemy :5432 | DB user/pass | None | Internal"

' ===========================================================================
' FUTURE FLOWS (dashed gray)
' ===========================================================================

sync_api -[#90A4AE,dashed]-> referentiel : "**F19** Sync API -> Referential (read reference data)\nREST/HTTPS | Service account | TLS | External"

sync_api -[#90A4AE,dashed]-> ldap : "**F20** Sync API -> LDAP (sync claims & entitlements)\nLDAP :389/636 | Service account | TLS (LDAPS) | Internal"

auth -[#90A4AE,dashed]-> ldap : "**F21** LemonLDAP -> LDAP (read claims & entitlements)\nLDAP :389/636 | Service account | TLS (LDAPS) | Internal"

' ===========================================================================
' LEGEND
' ===========================================================================

legend right
  |= Color |= Scope |
  |<#EF5350>  | External flow (from outside the Docker network) |
  |<#66BB6A>  | Internal flow (within the Docker network) |
  |<#90A4AE>  | Future flow (target architecture, not yet implemented) |
  |           |                 |
  |= Field   |= Description     |
  | Port     | Host port -> container port (or container port only if internal) |
  | Protocol | HTTPS, HTTP, REST, JDBC, DBI, SQLAlchemy, LDAP |
  | Auth     | Session cookie, JWT, username/password, client certificate, service account, DB credentials, none |
  | Encrypt  | TLS, mutual TLS, or None (plaintext within the Docker network) |
  |           |                 |
  | e2e only | Also published on the host for tests: OPA :8181, Sync API :8444, PostgreSQL :5432. Not to expose in production. |
endlegend

@enduml
