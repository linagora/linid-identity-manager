{
  "instanceId": "moduleGroupCreationPage",
  "remoteName": "LinPulsar",
  "entity": "groups",
  "lifecycleRemote": "LinPulsar/PageLifecycle",
  "routesRemote": "LinPulsar/PageRoutes",
  "i18nRemote": "LinPulsar/EmptyI18n",
  "apiEndpoint": "groups",
  "basePath": "/groups",
  "options": {
    "layout": "LinPulsar/BaseLayout",
    "page": "LinPulsar/GenericCreationPage",
    "pagePath": "new",
    "parentPath": "/groups",
    "successPath": "/groups/{{ entity.id }}",
    "idKey": "id",
    "formSections": [
      {
        "id": "general",
        "fields": [
          {
            "name": "code",
            "input": "Text",
            "required": true,
            "inputSettings": {
              "pattern": "^[a-zA-Z-_0-9]+$"
            }
          },
          {
            "name": "name",
            "input": "Text",
            "required": true
          },
          {
            "name": "parentId",
            "input": "DynamicList",
            "inputSettings": {
              "route": "/groups",
              "optionLabel": "{{ name }}",
              "optionValue": "{{ id }}",
              "size": 50
            }
          },
          {
            "name": "description",
            "input": "TextArea"
          },
          {
            "name": "organizationalUnitId",
            "input": "DynamicList",
            "inputSettings": {
              "route": "/organizational-units",
              "optionLabel": "{{ name }}",
              "optionValue": "{{ id }}",
              "size": 50
            }
          },
          {
            "name": "applicationId",
            "input": "DynamicList",
            "inputSettings": {
              "route": "/applications",
              "optionLabel": "{{ name }}",
              "optionValue": "{{ id }}",
              "size": 50
            }
          },
          {
            "name": "email",
            "input": "Email"
          }
        ]
      }
    ]
  }
}
