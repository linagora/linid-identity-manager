{
  "instanceId": "moduleApplicationDetailsPage",
  "remoteName": "catalogUI",
  "entity": "applications",
  "lifecycleRemote": "catalogUI/PageLifecycle",
  "routesRemote": "catalogUI/PageRoutes",
  "i18nRemote": "catalogUI/EmptyI18n",
  "apiEndpoint": "applications",
  "basePath": "/applications",
  "zones": [
    {
      "zone": "moduleApplicationDetailsPage.side-left",
      "plugin": "catalogUI/EntityProfilePanel",
      "props": {
        "parentPath": "/applications",
        "fieldOrder": ["type", "domain", "description"],
        "avatarOptions": {
          "seed": ["{{ entity.code }}"],
          "style": "shape-grid"
        },
        "updateEndpoint": "/applications/{{ entity.id }}",
        "updateBody": {
          "code": "{{ entity.code }}",
          "name": "{{ entity.name }}",
          "type": "{{ entity.type }}",
          "domain": "{{ entity.domain }}",
          "description": "{{ entity.description }}",
          "claimsTemplate": "{{ entity.claimsTemplate }}",
          "extraParameters": "{{ entity.extraParameters }}"
        },
        "formFields": [
          {
            "name": "code",
            "input": "Text",
            "required": true
          },
          {
            "name": "name",
            "input": "Text",
            "required": true
          },
          {
            "name": "type",
            "input": "Text",
            "required": true
          },
          {
            "name": "domain",
            "input": "Text"
          },
          {
            "name": "description",
            "input": "TextArea"
          },
          {
            "name": "claimsTemplate",
            "input": "TextArea",
            "required": true
          }
        ],
        "emitOnUpdate": "application-updated"
      }
    },
    {
      "zone": "moduleApplicationDetailsPage.entity-profile-panel.actions.prepend",
      "component": "ExportApplicationScriptBtn"
    },
    {
      "zone": "moduleApplicationDetailsPage.content.after",
      "plugin": "catalogUI/GenericEditableTableCard",
      "props": {
        "rowKey": "id",
        "columns": [
          {
            "name": "name",
            "label": "columns.name",
            "field": "name",
            "align": "left"
          },
          {
            "name": "description",
            "label": "columns.description",
            "field": "description",
            "align": "left"
          }
        ],
        "formFields": [
          {
            "name": "name",
            "type": "String",
            "input": "Text",
            "required": true,
            "inputSettings": {}
          },
          {
            "name": "description",
            "type": "String",
            "input": "TextArea",
            "required": false,
            "inputSettings": {}
          }
        ],
        "endpoints": {
          "find": "/applications/{{ entity.id }}/roles",
          "create": "/applications/{{ entity.id }}/roles",
          "update": "/applications/{{ entity.id }}/roles/{{ item.id }}",
          "delete": "/applications/{{ entity.id }}/roles/{{ item.id }}"
        }
      }
    },
    {
      "zone": "moduleApplicationDetailsPage.content.after",
      "plugin": "catalogUI/GenericSortableListCard",
      "props": {
        "itemKey": "id",
        "listenToItemUpdate": "update:item",
        "fields": [
          {
            "name": "code",
            "label": "fields.code"
          },
          {
            "name": "description",
            "label": "fields.description"
          }
        ],
        "orderKey": "priority",
        "formFields": [
          {
            "name": "code",
            "type": "String",
            "input": "Text",
            "required": true
          },
          {
            "name": "description",
            "type": "String",
            "input": "Text"
          },
          {
            "name": "priority",
            "type": "Integer",
            "input": "Number",
            "required": true,
            "inputSettings": {
              "disable": true
            }
          },
          {
            "name": "script",
            "type": "String",
            "input": "TextArea",
            "required": true
          },
          {
            "name": "disabled",
            "type": "Boolean",
            "input": "Boolean",
            "inputSettings": {
              "disable": true,
              "defaultValue": true,
              "trueValue": false,
              "falseValue": true
            }
          }
        ],
        "endpoints": {
          "find": "/applications/{{ entity.id }}/rules",
          "create": "/applications/{{ entity.id }}/rules",
          "update": "/applications/{{ entity.id }}/rules/{{ item.id }}",
          "delete": "/applications/{{ entity.id }}/rules/{{ item.id }}"
        }
      }
    },
    {
      "zone": "moduleApplicationDetailsPage.generic-sortable-list-card.item.actions",
      "plugin": "catalogUI/EntityAttributeField",
      "props": {
        "definition": {
          "name": "disabled",
          "type": "Boolean",
          "input": "Boolean",
          "inputSettings": {
            "trueValue": false,
            "falseValue": true
          }
        },
        "emitOnUpdate": "update:item"
      }
    }
  ],
  "options": {
    "layout": "catalogUI/BaseLayout",
    "page": "catalogUI/GenericDetailsPage",
    "pagePath": ":id",
    "parentPath": "/applications",
    "enableActions": false,
    "reloadDetailsOn": ["application-updated"],
    "sections": [
      {
        "key": "claims",
        "fieldOrder": ["claimsTemplate"]
      },
      {
        "key": "audit",
        "formatters": [
          {
            "field": "insertDate",
            "formatter": "toDate",
            "formatOptions": {
              "formatKey": "application.dateFormat"
            }
          },
          {
            "field": "updateDate",
            "formatter": "toDate",
            "formatOptions": {
              "formatKey": "application.dateFormat"
            }
          }
        ],
        "fieldOrder": ["createdBy", "updatedBy", "insertDate", "updateDate"]
      }
    ]
  }
}
