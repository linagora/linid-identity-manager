@startuml C2-Containers
' ============================================================================
' LinID Identity Manager — C4 Level 2: Containers
' ============================================================================
' C4_Component (which includes C4_Container) is needed to show LinPulsar as a
' component of the LinOpenFactory container.
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Component.puml

AddElementTag("future", $fontColor="#777777", $borderColor="#999999", $borderStyle=DashedLine(), $legendText="future (target architecture)")
AddElementTag("optional", $borderStyle=DottedLine(), $legendText="optional")
AddRelTag("future", $textColor="#777777", $lineColor="#999999", $lineStyle=DashedLine(), $legendText="future flow")

' Layout: users on top, LinOpenFactory & SSO on the left, LinID in the middle,
' Superset & future referential on the right, PostgreSQL at the bottom.
LAYOUT_TOP_DOWN()
HIDE_STEREOTYPE()
skinparam nodesep 70
skinparam ranksep 90

title LinID Identity Manager — Containers (C2)

' --- Actors -----------------------------------------------------------------
Person(admin, "Administrator / manager", "Manages identities, applications, rules")
Person(enduser, "End user", "Logs in, manages preferences, views dashboards")

' --- Left: LinOpenFactory & SSO ---------------------------------------------
Container_Boundary(lof, "LinOpenFactory") {
  Component(lin_pulsar, "LinPulsar", "Vue 3, Quasar, Module Federation remote (v0.3.0)", "Shared UI components: layouts, generic pages, forms, dialogs, filters, Superset widget.")
}

Container_Boundary(sso, "SSO / Identity") {
  Container(auth, "LemonLDAP::NG", "LemonLDAP::NG 2.23", "OIDC IdP & SSO portal, issues RS256 JWT access tokens.")
  ContainerDb(ldap, "LDAP Directory", "LDAP server", "Claims & entitlements per user.", $tags="future")
}

' --- Middle: LinID ----------------------------------------------------------------
System_Boundary(linid, "LinID Identity Manager") {
  Container(spa, "LinID UI (SPA)", "Vue 3.5, Quasar 2.21, Module Federation host", "Runs in the browser, pages built from config.json with LinPulsar components. Holds only a session cookie.")
  Container(bff, "UI server (BFF)", "Node.js, Fastify 5", "Serves the SPA; OIDC (code + PKCE); tokens kept in a server session; proxies /backend, /auth, /lin-pulsar.")
  Container(api, "LinID API", "Java 25, Spring Boot 4.1, JPA, Flyway", "REST API for identities, applications, rules, avatars, preferences, i18n. Deploys Rego policies, issues Superset guest tokens.")
  Container(sync_api, "LinID Sync API", "Java 25, Spring Boot 4.1, Spring Batch", "Batch jobs computing the rights of each account on each application. Mutual TLS.")
  Container(opa, "Open Policy Agent", "OPA 1.18.1", "One Rego policy per application, evaluates {allow, roles}.")
}

' --- Right: Superset & future referential -----------------------------------------
Container_Ext(superset, "Apache Superset", "Apache Superset 6.1.0", "Embedded dashboards via guest tokens with RLS.", $tags="optional")
System_Ext(referentiel, "External Referential", "Master data source (e.g. HR system).", $tags="future")

' --- Bottom: PostgreSQL (ordered to sit under their clients) ------------------------
Container_Boundary(postgres, "PostgreSQL 18.4") {
  ContainerDb(db_lemon, "lemon", "PostgreSQL", "LemonLDAP::NG user directory.")
  ContainerDb(db_linid, "linid", "PostgreSQL", "Business data, computed rights.")
  ContainerDb(db_sync, "sync_api", "PostgreSQL", "Spring Batch metadata.")
  ContainerDb(db_superset, "superset", "PostgreSQL", "Superset metadata.", $tags="optional")
  ContainerDb(db_datalake, "datalake", "PostgreSQL", "Dashboard data.", $tags="optional")
}
Lay_R(db_lemon, db_linid)
Lay_R(db_linid, db_sync)
Lay_R(db_sync, db_superset)
Lay_R(db_superset, db_datalake)

' --- Relationships: actors ---------------------------------------------------
Rel_D(admin, spa, "Uses", "HTTPS")
Rel_D(enduser, spa, "Uses", "HTTPS")
Rel(admin, api, "Swagger UI", "HTTPS/REST")
Rel_D(admin, superset, "Creates dashboards", "HTTPS")

' --- Relationships: frontend -------------------------------------------------
Rel_D(spa, bff, "Session cookie: /auth/*, /backend/*", "HTTPS")
Rel_L(spa, lin_pulsar, "Runs federated components", "Module Federation")
Rel_R(spa, superset, "Embedded dashboards (guest token)", "HTTPS")
Rel_L(bff, auth, "OIDC code exchange, token refresh, userinfo, portal proxy", "HTTP")
Rel_U(bff, lin_pulsar, "Proxies /lin-pulsar/", "HTTP")
Rel_D(bff, api, "Proxies /backend/ with Bearer token", "HTTPS/REST")

' --- Relationships: backend ---------------------------------------------------
Rel_U(api, bff, "Fetches JWKS (/auth/oauth2/jwks)", "HTTPS")
Rel_R(api, sync_api, "Calls", "REST/HTTPS, mutual TLS")
Rel_D(api, opa, "Publishes Rego policies", "REST/HTTP")
Rel_R(api, superset, "Guest tokens", "REST/HTTPS")
Rel_D(api, db_linid, "Reads/writes", "JDBC")

Rel_D(sync_api, opa, "Evaluates decisions", "REST/HTTP")
Rel_D(sync_api, db_linid, "Reads accounts, writes computed_rights", "JDBC")
Rel_D(sync_api, db_sync, "Batch metadata", "JDBC")

Rel_D(auth, db_lemon, "Reads user directory", "DBI")
Rel_D(superset, db_superset, "Metadata", "SQLAlchemy")
Rel_D(superset, db_datalake, "Dashboard data", "SQLAlchemy")

' --- Relationships: future -----------------------------------------------------
Rel_R(sync_api, referentiel, "Reads reference data", "REST/HTTPS", $tags="future")
Rel_L(sync_api, ldap, "Syncs claims & entitlements", "LDAP", $tags="future")
Rel_D(auth, ldap, "Reads claims & entitlements", "LDAP", $tags="future")

SHOW_LEGEND()
@enduml
