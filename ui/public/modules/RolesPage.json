{
  "instanceId": "moduleRolesPage",
  "remoteName": "catalogUI",
  "entity": "roles",
  "lifecycleRemote": "catalogUI/PageLifecycle",
  "routesRemote": "catalogUI/PageRoutes",
  "i18nRemote": "catalogUI/EmptyI18n",
  "apiEndpoint": "roles",
  "basePath": "/roles",
  "zones": [
    {
      "zone": "moduleRolesPage.row-actions",
      "plugin": "catalogUI/FormDialogButton",
      "props": {
        "url": "/roles/{{ entity.id }}",
        "method": "PUT",
        "fillFormWithEntity": true,
        "body": {
          "code": "{{ entity.code }}",
          "name": "{{ entity.name }}",
          "description": "{{ entity.description }}"
        },
        "formFields": [
          {
            "name": "name",
            "type": "String",
            "input": "Text",
            "required": true,
            "inputSettings": {}
          },
          {
            "name": "description",
            "type": "String",
            "input": "TextArea",
            "required": false,
            "inputSettings": {}
          }
        ],
        "emitOnSubmit": "description-updated"
      }
    },
    {
      "zone": "moduleRolesPage.row-actions",
      "plugin": "catalogUI/ConfirmDialogButton",
      "props": {
        "url": "/roles/{{ entity.id }}",
        "method": "DELETE",
        "disable": "{{ not entity.deletable }}",
        "emitOnSubmit": "role-deleted"
      }
    }
  ],
  "options": {
    "layout": "catalogUI/BaseLayout",
    "addNavigationMenu": true,
    "page": "catalogUI/GenericTablePage",
    "pagePath": "",
    "idKey": "id",
    "enableActions": true,
    "enableSeeButton": false,
    "creationPagePath": "/roles/new",
    "reloadTableOn": ["description-updated", "role-deleted"],
    "filters": [
      {
        "name": "code",
        "type": "text"
      },
      {
        "name": "name",
        "type": "text"
      },
      {
        "name": "description",
        "type": "text"
      },
      {
        "name": "organizationalUnitId",
        "type": "tree",
        "options": {
          "url": "/organizational-units",
          "idKey": "id",
          "parentsKey": "parents",
          "parentIdKey": "parent",
          "nodesQuerySize": 50,
          "typeKey": "type"
        },
        "dynamicLabelOptions": {
          "url": "/organizational-units?id={{ values | join('|') }}",
          "responseItemsPath": "content",
          "valuePath": "id"
        }
      }
    ],
    "columns": [
      {
        "label": "columns.code",
        "name": "code",
        "field": "code",
        "sortable": true,
        "align": "left"
      },
      {
        "label": "columns.name",
        "name": "name",
        "field": "name",
        "sortable": true,
        "align": "left"
      },
      {
        "label": "columns.description",
        "name": "description",
        "field": "description",
        "sortable": true,
        "align": "left"
      },
      {
        "label": "columns.organizationalUnits",
        "name": "organizationalUnits",
        "field": "organizationalUnits",
        "sortable": true,
        "align": "left"
      },
      {
        "label": "columns.actions",
        "name": "table_actions",
        "field": "",
        "sortable": false,
        "align": "center"
      }
    ]
  }
}
