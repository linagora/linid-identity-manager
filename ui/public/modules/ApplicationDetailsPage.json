{
  "instanceId": "moduleApplicationDetailsPage",
  "remoteName": "catalogUI",
  "entity": "applications",
  "lifecycleRemote": "catalogUI/PageLifecycle",
  "routesRemote": "catalogUI/PageRoutes",
  "i18nRemote": "catalogUI/EmptyI18n",
  "apiEndpoint": "applications",
  "basePath": "/applications",
  "zones": [
    {
      "zone": "moduleApplicationDetailsPage.header.actions",
      "component": "ExportApplicationScriptBtn"
    },
    {
      "zone": "moduleApplicationDetailsPage.content.after",
      "plugin": "catalogUI/GenericEditableTableCard",
      "props": {
        "rowKey": "id",
        "columns": [
          {
            "name": "name",
            "label": "columns.name",
            "field": "name",
            "align": "left"
          },
          {
            "name": "description",
            "label": "columns.description",
            "field": "description",
            "align": "left"
          }
        ],
        "formFields": [
          {
            "name": "name",
            "type": "String",
            "input": "Text",
            "required": true,
            "inputSettings": {}
          },
          {
            "name": "description",
            "type": "String",
            "input": "TextArea",
            "required": false,
            "inputSettings": {}
          }
        ],
        "endpoints": {
          "find": "/applications/{{ entity.id }}/roles",
          "create": "/applications/{{ entity.id }}/roles",
          "update": "/applications/{{ entity.id }}/roles/{{ item.id }}",
          "delete": "/applications/{{ entity.id }}/roles/{{ item.id }}"
        }
      }
    },
    {
      "zone": "moduleApplicationDetailsPage.content.after",
      "plugin": "catalogUI/GenericSortableListCard",
      "props": {
        "itemKey": "id",
        "listenToItemUpdate": "update:item",
        "fields": [
          {
            "name": "code",
            "label": "fields.code"
          },
          {
            "name": "description",
            "label": "fields.description"
          }
        ],
        "orderKey": "priority",
        "formFields": [
          {
            "name": "code",
            "type": "String",
            "input": "Text",
            "required": true
          },
          {
            "name": "description",
            "type": "String",
            "input": "Text"
          },
          {
            "name": "priority",
            "type": "Integer",
            "input": "Number",
            "required": true,
            "inputSettings": {
              "disable": true
            }
          },
          {
            "name": "script",
            "type": "String",
            "input": "TextArea",
            "required": true
          },
          {
            "name": "disabled",
            "type": "Boolean",
            "input": "Boolean",
            "inputSettings": {
              "disable": true,
              "defaultValue": true,
              "trueValue": false,
              "falseValue": true
            }
          }
        ],
        "endpoints": {
          "find": "/applications/{{ entity.id }}/rules",
          "create": "/applications/{{ entity.id }}/rules",
          "update": "/applications/{{ entity.id }}/rules/{{ item.id }}",
          "delete": "/applications/{{ entity.id }}/rules/{{ item.id }}"
        }
      }
    },
    {
      "zone": "moduleApplicationDetailsPage.generic-sortable-list-card.item.actions",
      "plugin": "catalogUI/EntityAttributeField",
      "props": {
        "definition": {
          "name": "disabled",
          "type": "Boolean",
          "input": "Boolean",
          "inputSettings": {
            "trueValue": false,
            "falseValue": true
          }
        },
        "emitOnUpdate": "update:item"
      }
    }
  ],
  "options": {
    "layout": "catalogUI/BaseLayout",
    "page": "catalogUI/GenericDetailsPage",
    "pagePath": ":id",
    "parentPath": "/applications",
    "editPath": "/applications/{{ entity.id }}/edit",
    "sections": [
      {
        "key": "identity",
        "fieldOrder": ["code", "name", "type", "domain", "description"]
      },
      {
        "key": "audit",
        "formatters": [
          {
            "field": "insertDate",
            "formatter": "toDate",
            "formatOptions": {
              "formatKey": "application.dateFormat"
            }
          },
          {
            "field": "updateDate",
            "formatter": "toDate",
            "formatOptions": {
              "formatKey": "application.dateFormat"
            }
          }
        ],
        "fieldOrder": ["createdBy", "updatedBy", "insertDate", "updateDate"]
      }
    ]
  }
}
