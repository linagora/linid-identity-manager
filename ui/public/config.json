{
  "environment": "__APP_ENV__",
  "i18n": {
    "languages": ["fr-FR", "en-US"],
    "locale": "fr-FR",
    "i18nFiles": [
      "common.json",
      "accounts.json",
      "applications.json",
      "organizational-units.json",
      "roles.json",
      "groups.json"
    ]
  },
  "themeVariables": {
    "primary": "#0A84FF",
    "secondary": "#7A7781",
    "accent": "#9c27b0",
    "dark": "#1d1d1d",
    "positive": "#00C853",
    "negative": "#FF3347",
    "info": "#00BFA5",
    "warning": "#FF8F00",
    "background": "#F3F6F9",
    "background-search-bar": "#E0E9F1"
  },
  "remotes": [
    {
      "name": "LinPulsar",
      "entry": "http://localhost:5001/mf-manifest.json"
    }
  ],
  "modules": [
    "/modules/AccountsPage.json",
    "/modules/AccountCreationPage.json",
    "/modules/AccountDetailsPage.json",
    "/modules/OrganizationalUnitPage.json",
    "/modules/OrganizationalUnitCreationPage.json",
    "/modules/OrganizationalUnitDetailsPage.json",
    "/modules/GroupsPage.json",
    "/modules/GroupCreationPage.json",
    "/modules/GroupDetailsPage.json",
    "/modules/RolesPage.json",
    "/modules/RoleCreationPage.json",
    "/modules/ApplicationsPage.json",
    "/modules/ApplicationCreationPage.json",
    "/modules/ApplicationDetailsPage.json"
  ],
  "extraZones": [],
  "designFiles": [
    "design/default.json",
    "design/base-layout.json",
    "design/account-details.json",
    "design/organizational-unit-details.json",
    "design/organizational-unit-info-text.json",
    "design/status-badge.json",
    "design/account-info-text.json",
    "design/accounts-page.json",
    "design/applications-page.json",
    "design/application-creation.json",
    "design/account-creation.json",
    "design/organizational-units-page.json",
    "design/organizational-unit-creation.json",
    "design/application-details.json",
    "design/roles-page.json",
    "design/role-creation.json",
    "design/groups-page.json",
    "design/group-creation.json",
    "design/group-details.json"
  ]
