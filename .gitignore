# Logs
*.log

# Local overrides
docker-compose.override.yml

# Plugin JARs (downloaded at runtime)
docker/plugins/

# Intellij
.idea

# UI build artifacts (handled by ui/.gitignore but also ignored at root)
ui/node_modules/
ui/dist/
ui/.quasar/
ui/coverage/

# Generated files
docker/**/*.crt
docker/**/*.key
docker/**/*.pub
docker/**/*.jks
docker/dev/resources/llng
docker/e2e/resources/local
docker/e2e/resources/ci
api/**/*.jks
api/**/*.p12

# Uploaded avatars (shared API / nginx directory), except the default administrator avatar
docker/avatars/*
!docker/avatars/accounts/
docker/avatars/accounts/*
!docker/avatars/accounts/00000000-0000-4000-8000-00000000a001.png
