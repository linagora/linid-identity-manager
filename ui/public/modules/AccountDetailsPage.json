  "options": {
    "layout": "LinPulsar/BaseLayout",
    "page": "LinPulsar/GenericDetailsPage",
    "pagePath": ":id",
    "parentPath": "/accounts",
    "enableActions": false,
    "reloadDetailsOn": ["account-status-updated", "account-updated"],
    "sections": [
      {
        "key": "lifecycle",
        "fieldOrder": [
          "insertDate",
          "activationAt",
          "validityPeriod.start",
          "validityPeriod.end",
          "suspensionPeriod.start",
          "suspensionPeriod.end"
        ],
        "formatters": [
          {
            "field": "insertDate",
            "formatter": "toDate",
            "formatOptions": {
              "formatKey": "application.dateFormat"
            }
          },
          {
            "field": "activationAt",
            "formatter": "toDate",
            "formatOptions": {
              "formatKey": "application.dateFormat"
            }
          },
          {
            "field": "validityPeriod.start",
            "formatter": "toDate",
            "formatOptions": {
              "formatKey": "application.dateFormat"
            }
          },
          {
            "field": "validityPeriod.end",
