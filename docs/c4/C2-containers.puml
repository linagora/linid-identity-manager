@startuml C2-Containers
' ============================================================================
' LinID Identity Manager — C4 Level 2: Containers
' ============================================================================
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()
title LinID Identity Manager — Containers (C2)

' --- Actors -----------------------------------------------------------------
Person(admin, "Administrator", "Manages identities, applications, rules, dashboards")
Person(enduser, "End user", "Authenticates, uses UI, manages preferences, views dashboards")

System_Boundary(linid, "LinID Identity Manager") {

  ' --- Frontend -----------------------------------------------------------
  Container(ui, "LinID UI", "Vue 3.5, Quasar 2.21, Module Federation (host), Nginx", "SPA host application. Handles OIDC flow (oidc-client-ts), loads remote modules at runtime from remotes.json, proxies API/auth/catalog-ui requests via Nginx.")
  Container(catalog_ui, "Catalog UI", "Vue 3.5, Quasar 2.21, Module Federation (remote 'catalogUI'), Nginx", "Module Federation remote exposing shared UI components (layouts, tables, trees, forms, fields, cards, Superset widget). Will also incorporate the import feature.")

  ' --- Backend ------------------------------------------------------------
  Container(api, "LinID API", "Java 25, Spring Boot 4.1.0, Spring Data JPA, Flyway, MapStruct", "Core REST API. Manages accounts, OUs, applications, roles, rules (Rego fragments), user preferences, i18n. Compiles Rego policies and deploys them to OPA on a schedule. Generates Superset guest tokens with RLS.")

  ' --- Future: sync brick -------------------------------------------------
  Container(flink, "Apache Flink sync brick (future)", "Apache Flink", "Reads reference identity data from external referentials, computes per account/application profiles (claims + entitlements) by evaluating OPA decisions, stores them in account_application_profiles, syncs referential data into the LinID database, and syncs claims & entitlements to LDAP.")

  ' --- Policy & Analytics (configured off-the-shelf tools) ----------------
  Container(opa, "Open Policy Agent", "OPA 1.18.1", "Policy decision point. Stores Rego policies pushed by the API (one per application) and evaluates access decisions returning {allow, roles}.")
  Container(superset, "Apache Superset", "Apache Superset 6.1.0, Gunicorn (HTTPS)", "Embedded BI dashboard engine. Stores metadata in the superset DB, reads analytical data from the datalake DB. Serves embedded dashboards via guest tokens with RLS.")
}

' --- SSO boundary (current + future) ---------------------------------------
Container_Boundary(sso, "SSO / Identity") {
  Container(auth, "LemonLDAP::NG", "LemonLDAP::NG 2.23", "OIDC IdP & SSO portal. Authenticates users against its PostgreSQL directory, issues JWT tokens (RS256). Target: a LemonLDAP script will convert synced claims & entitlements into per-application JWTs.")
  ContainerDb(ldap, "LDAP Directory (future)", "LDAP server", "Stores claims & entitlements per user, written by the Flink sync brick and read by LemonLDAP::NG to build per-application JWT tokens.")
}

' --- External data store ---------------------------------------------------
Container_Boundary(postgres, "PostgreSQL 18.4") {
  ContainerDb(db_linid, "linid", "PostgreSQL", "LinID business data + Flyway migrations.")
  ContainerDb(db_lemon, "lemon", "PostgreSQL", "LemonLDAP::NG user directory & sessions.")
  ContainerDb(db_superset, "superset", "PostgreSQL", "Superset metadata (dashboards, charts, users, roles, datasets).")
  ContainerDb(db_datalake, "datalake", "PostgreSQL", "Analytical data consumed by Superset dashboards.")
}

' --- External containers (future) ------------------------------------------
System_Ext(referentiel, "External Referential (future)", "Master data source (e.g. HR system) providing reference identity data (accounts, organizational units) that the Flink sync brick reads to update the LinID database.")

' --- Relationships: actors -> containers -----------------------------------
Rel(admin, ui, "Manages identities, applications, rules, dashboards", "HTTPS")
Rel(enduser, ui, "Authenticates, uses UI, manages preferences, views dashboards", "HTTPS")
Rel(admin, api, "Manages accounts, OUs, applications, roles, rules, deploys policies", "HTTPS/REST")
Rel(admin, superset, "Creates & configures new dashboards for embedding", "HTTPS")
Rel(enduser, api, "Reads/writes preferences, requests Superset guest tokens", "HTTPS/REST")

' --- Relationships: frontend -----------------------------------------------
Rel(ui, api, "Proxies API calls via /backend/", "HTTPS/REST")
Rel(ui, auth, "OIDC login flow (authorization code + PKCE), token renewal via /auth/", "OIDC/HTTPS")
Rel(ui, catalog_ui, "Loads Module Federation remote components via /catalog-ui/", "HTTP")
Rel(ui, api, "Fetches i18n translations", "HTTPS/REST")

' --- Relationships: backend -------------------------------------------------
Rel(api, db_linid, "Reads/writes LinID business data", "JDBC")
Rel(api, auth, "Fetches OIDC JWKS for JWT validation", "OIDC/HTTPS")
Rel(api, opa, "Publishes Rego policies (PUT /v1/policies/{id})", "REST/HTTP")
Rel(api, opa, "Scheduled deployment of pending policies (every 5 min)", "REST/HTTP")
Rel(api, superset, "Login, CSRF, guest token generation, dashboard config", "REST/HTTPS")

' --- Relationships: LemonLDAP ----------------------------------------------
Rel(auth, db_lemon, "Reads user directory & sessions", "DBI/PostgreSQL")

' --- Relationships: Superset -----------------------------------------------
Rel(superset, db_superset, "Reads/writes metadata", "SQLAlchemy/psycopg2")
Rel(superset, db_datalake, "Reads analytical data", "SQLAlchemy/psycopg2")

' --- Relationships: future sync brick --------------------------------------
Rel(flink, referentiel, "Reads source reference data (accounts, organizational units)", "REST/HTTPS")
Rel(flink, opa, "Evaluates decisions to compute entitlements", "REST/HTTP")
Rel(flink, db_linid, "Syncs referential data & writes computed profiles (account_application_profiles)", "JDBC")
Rel(flink, ldap, "Syncs claims & entitlements per user", "LDAP")
Rel(auth, ldap, "Reads claims & entitlements to build per-application JWT", "LDAP")

@enduml