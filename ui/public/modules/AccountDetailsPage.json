{
  "instanceId": "moduleAccountDetailsPage",
  "remoteName": "LinPulsar",
  "entity": "accounts",
  "lifecycleRemote": "LinPulsar/PageLifecycle",
  "routesRemote": "LinPulsar/PageRoutes",
  "i18nRemote": "LinPulsar/EmptyI18n",
  "apiEndpoint": "accounts",
  "basePath": "/accounts",
  "zones": [
    {
      "zone": "moduleAccountDetailsPage.side-left",
      "plugin": "LinPulsar/EntityProfilePanel",
      "props": {
        "statusKey": "status",
        "parentPath": "/accounts",
        "fieldOrder": ["externalId", "email"],
        "avatarOptions": {
          "seed": ["{{ entity.firstname }}", " ", "{{ entity.lastname }}"],
          "style": "initials"
        },
        "avatarLocation": "/avatars/accounts/{{ entity.id }}.png",
        "importOptions": {
          "enabled": true,
          "maxFileSize": 10,
          "allowedExtensions": ["png"],
          "endpoints": {
            "upload": "/avatars/accounts/{{ entity.id }}",
            "delete": "/avatars/accounts/{{ entity.id }}"
          }
        },
        "updateEndpoint": "/accounts/{{ entity.id }}",
        "updateBody": {
          "externalId": "{{ entity.externalId }}",
          "lastname": "{{ entity.lastname }}",
          "firstname": "{{ entity.firstname }}",
          "email": "{{ entity.email }}"
        },
        "formFields": [
          {
            "name": "externalId",
            "type": "String",
            "input": "Text",
            "required": true,
            "inputSettings": {}
          },
          {
            "name": "firstname",
            "type": "String",
            "input": "Text",
            "required": true,
            "inputSettings": {}
          },
          {
            "name": "lastname",
            "type": "String",
            "input": "Text",
            "required": true,
            "inputSettings": {}
          },
          {
            "name": "email",
            "type": "String",
            "input": "Email",
            "required": true,
            "inputSettings": {}
          }
        ],
        "emitOnUpdate": "account-updated"
      }
    },
    {
      "zone": "moduleAccountDetailsPage.content.before",
      "component": "AccountLifecyclePanel",
      "props": {
        "banners": [
          {
            "key": "suspended",
            "actions": ["reactivation.immediate", "suspension.modify"],
            "content": "{{ 'contentWithEndDate' if entity.suspensionPeriod.end else 'content' }}",
            "params": {
              "date": {
                "field": "suspensionPeriod.start",
                "formatter": "toDate",
                "formatOptions": {
                  "formatKey": "application.dateFormat"
                }
              },
              "endDate": {
                "field": "suspensionPeriod.end",
                "formatter": "toDate",
                "formatOptions": {
                  "formatKey": "application.dateFormat"
                }
              }
            }
          },
          {
            "key": "deactivated",
            "actions": ["revalidation.immediate", "revalidation.scheduled"],
            "params": {
              "date": {
                "field": "validityPeriod.end",
                "formatter": "toDate",
                "formatOptions": {
                  "formatKey": "application.dateFormat"
                }
              }
            }
          },
          {
            "key": "deactivation-warning",
            "actions": ["deactivation.immediate", "deactivation.modify"],
            "params": {
              "count": {
                "field": "daysBeforeDeactivation"
              },
              "date": {
                "field": "validityPeriod.end",
                "formatter": "toDate",
                "formatOptions": {
                  "formatKey": "application.dateFormat"
                }
              }
            }
          }
        ],
        "immediateActionDelay": 60,
        "actions": {
          "activation.immediate": {
            "dialog": "confirmation",
            "url": "/accounts/{{ entity.id }}/status/schedule-activation",
            "method": "PUT",
            "body": {
              "validityStart": "{{ immediateDate }}"
            }
          },
          "suspension.immediate": {
            "dialog": "form",
            "url": "/accounts/{{ entity.id }}/status/suspend",
            "method": "PUT",
            "formFields": [
              {
                "name": "statusReason",
                "type": "String",
                "input": "List",
                "required": true,
                "inputSettings": {
                  "values": [
                    "Suspension Reason A",
                    "Suspension Reason B",
                    "Suspension Reason C"
                  ]
                }
              },
              {
                "name": "statusSubreason",
                "type": "String",
                "input": "List",
                "required": true,
                "inputSettings": {
                  "values": [
                    {
                      "value": "Suspension Sub-reason A.1",
                      "filterContext": {
                        "statusReason": "Suspension Reason A"
                      }
                    },
                    {
                      "value": "Suspension Sub-reason A.2",
                      "filterContext": {
                        "statusReason": "Suspension Reason A"
                      }
                    },
                    {
                      "value": "Suspension Sub-reason B.1",
                      "filterContext": {
                        "statusReason": "Suspension Reason B"
                      }
                    },
                    {
                      "value": "Suspension Sub-reason C.1",
                      "filterContext": {
                        "statusReason": "Suspension Reason C"
                      }
                    }
                  ]
                }
              },
              {
                "name": "statusComment",
                "type": "String",
                "input": "TextArea",
                "required": false
              }
            ],
            "body": {
              "suspensionPeriod": {
                "start": "{{ immediateDate }}"
              },
              "reason": "{{ entity.statusReason }}",
              "subreason": "{{ entity.statusSubreason }}",
              "comment": "{{ entity.statusComment }}"
            }
          },
          "deactivation.immediate": {
            "dialog": "form",
            "url": "/accounts/{{ entity.id }}/status/deactivate",
            "method": "PUT",
            "formFields": [
              {
