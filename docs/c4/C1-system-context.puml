@startuml C1-System-Context
' ============================================================================
' LinID Identity Manager — C4 Level 1: System Context
' ============================================================================
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.13.0/C4_Context.puml

AddElementTag("future", $fontColor="#777777", $borderColor="#999999", $borderStyle=DashedLine(), $legendText="future (target architecture)")
AddElementTag("optional", $borderStyle=DottedLine(), $legendText="optional")
AddRelTag("future", $textColor="#777777", $lineColor="#999999", $lineStyle=DashedLine(), $legendText="future flow")

LAYOUT_WITH_LEGEND()
title LinID Identity Manager — System Context (C1)

' --- Actors -----------------------------------------------------------------
Person(admin, "Administrator / manager", "Manages accounts, organizational units, groups, roles, applications and authorization rules.")
Person(enduser, "End user", "Logs in, views own account and preferences, views embedded dashboards.")

' --- System -----------------------------------------------------------------
System(linid, "LinID Identity Manager", "IAM platform: identities, organizational structure, application permissions and policy-based authorization (PBAC) with an embedded Open Policy Agent.")

' --- External systems (current) --------------------------------------------
System_Ext(lof, "LinOpenFactory", "LINAGORA front-end platform. Provides LinPulsar, the shared UI component library loaded at runtime by the LinID UI.")
System_Ext(lemonldap, "LemonLDAP::NG", "OIDC Identity Provider & SSO portal.")
System_Ext(superset, "Apache Superset", "BI engine serving embedded dashboards with Row Level Security.", $tags="optional")
System_Ext(postgres, "PostgreSQL", "Databases: linid, sync_api, lemon, superset, datalake.")

' --- External systems (future) ---------------------------------------------
System_Ext(ldap, "LDAP Directory", "Claims & entitlements per user, read by LemonLDAP::NG to build per-application tokens.", $tags="future")
System_Ext(referentiel, "External Referential", "Master data source (e.g. HR system) for accounts and organizational units.", $tags="future")

' --- Relationships (current) ------------------------------------------------
Rel(admin, linid, "Manages identities, applications, rules", "HTTPS")
Rel(enduser, linid, "Logs in, manages preferences", "HTTPS")
Rel(admin, superset, "Creates dashboards", "HTTPS")
Rel(enduser, superset, "Views embedded dashboards (guest token)", "HTTPS")

Rel(linid, lof, "Loads shared UI components (LinPulsar)", "Module Federation/HTTP")
Rel(linid, lemonldap, "OIDC authentication, JWT validation via JWKS", "OIDC/HTTP(S)")
Rel(linid, superset, "Generates guest tokens with RLS", "REST/HTTPS")
Rel(linid, postgres, "Reads/writes business data", "JDBC")

Rel(lemonldap, postgres, "Reads user directory (lemon DB)", "DBI/PostgreSQL")
Rel(superset, postgres, "Reads/writes metadata & analytical data", "SQLAlchemy/psycopg2")

' --- Relationships (future) -------------------------------------------------
Rel(linid, referentiel, "Reads reference data (sync-api)", "REST/HTTPS", $tags="future")
Rel(linid, ldap, "Syncs claims & entitlements (sync-api)", "LDAP", $tags="future")
Rel(lemonldap, ldap, "Reads claims & entitlements", "LDAP", $tags="future")

@enduml
